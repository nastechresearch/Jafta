<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tutto il tema dell'app sta qui; Theme.Jafta aggiunge solo, da API 31
         in su, lo sfondo dello splash di sistema (values-v31/themes.xml). -->
    <style name="Base.Theme.Jafta" parent="Theme.AppCompat.Light.NoActionBar">
        <!-- Colori della starting window, cioè dei pochi istanti prima di
             onCreate: sono quelli di `synthwave`, il tema di default della WebUI.
             Da onCreate in poi finestra, barre, loading view ed error view
             prendono i colori dell'ultimo tema scelto (applyBootPalette). -->
        <item name="android:statusBarColor">#111013</item>
        <item name="android:navigationBarColor">#111013</item>
        <!-- Il default di AppCompat.Light è quasi bianco e lampeggia nella
             starting window, prima che la loading view dipinga. -->
        <item name="android:windowBackground">#111013</item>
    </style>

    <style name="Theme.Jafta" parent="Base.Theme.Jafta" />
</resources>
